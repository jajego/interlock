{
  "name": "interlock",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.18.0"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "check": "pnpm build && pnpm typecheck && pnpm test",
    "test": "node --test integration/core.test.mjs integration/conformance.test.mjs",
    "typecheck": "tsc -p tsconfig.type-tests.json --pretty false",
    "test:postgres": "node scripts/require-postgres.mjs && pnpm build && node --test integration/postgres.test.mjs",
    "format": "prettier --check .",
    "lint": "eslint .",
    "pack:check": "node scripts/pack-check.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.2",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "pg": "^8.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
